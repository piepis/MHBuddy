<view class="theme-{{theme}}">
  <input class="search" placeholder="按任务名搜索" value="{{q}}" bindinput="onInput" />
  <view wx:if="{{!rows.length}}" class="note">当前没有限时任务</view>
  <view wx:for="{{rows}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="open">
    <view class="row-main">
      <view class="row-title">{{item.title}}</view>
      <view class="meta">{{item.meta}}</view>
    </view>
    <text class="chev">›</text>
  </view>
</view>
